@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>Login</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>
        * {
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            margin: 0;
            height: 100vh;
            background: linear-gradient(135deg, #8e2de2, #4a00e0);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

            /* background infinity icons */
            body::before {
                content: "∞ ∞ ∞ ∞ ∞";
                position: absolute;
                inset: 0;
                font-size: 120px;
                opacity: 0.08;
                display: flex;
                align-items: center;
                justify-content: space-around;
                color: white;
                pointer-events: none;
            }

        .login-container {
            background: #fff;
            width: 360px;
            border-radius: 12px;
            padding: 28px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
            position: relative;
            z-index: 1;
        }

            .login-container h1 {
                margin: 0;
                font-size: 24px;
                font-weight: 700;
                color: #333;
            }

            .login-container p {
                margin-top: 6px;
                font-size: 14px;
                color: #777;
            }

        .form-group {
            margin-top: 18px;
        }

            .form-group label {
                display: block;
                font-size: 13px;
                color: #555;
                margin-bottom: 6px;
            }

        .input-wrapper {
            position: relative;
        }

            .input-wrapper input {
                width: 100%;
                padding: 10px 38px 10px 12px;
                border-radius: 8px;
                border: 1px solid #ddd;
                font-size: 14px;
            }

            .input-wrapper i {
                position: absolute;
                right: 12px;
                top: 50%;
                transform: translateY(-50%);
                color: #888;
                cursor: pointer;
            }

        .btn-login {
            width: 100%;
            margin-top: 24px;
            padding: 12px;
            background: #4a3aff;
            border: none;
            border-radius: 8px;
            color: white;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: background .2s;
        }

            .btn-login:hover {
                background: #3728d9;
            }

        .footer {
            position: absolute;
            bottom: 20px;
            text-align: center;
            font-size: 12px;
            color: rgba(255,255,255,0.8);
        }
    </style>
</head>
<body>

    <div class="login-container">
        <h1>Login</h1>
        <p>Preencha suas informações para efetuar o login</p>

        <form method="post">
            <div class="form-group">
                <label>E-mail</label>
                <div class="input-wrapper">
                    <input type="email" name="Email" placeholder="Digite o seu e-mail" required />
                </div>
            </div>

            <div class="form-group">
                <label>Senha</label>
                <div class="input-wrapper">
                    <input type="password" id="password" name="Senha" placeholder="Digite a sua senha" required />
                    <i class="fa-solid fa-eye" onclick="togglePassword()"></i>
                </div>
            </div>

            <button type="submit" class="btn-login">Entrar</button>
        </form>
    </div>

    <div class="footer">
        Secretaria de Ciência, Tecnologia e Inovação • Governo de Pernambuco
    </div>

    <script>
        function togglePassword() {
            const input = document.getElementById("password");
            input.type = input.type === "password" ? "text" : "password";
        }
    </script>

</body>
</html>
