@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>Loop - Bem-vindo</title>

    <style>
        body {
            margin: 0;
            height: 100vh;
            font-family: 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #7b2ff7, #3a5bff);
            display: flex;
            justify-content: center;
            align-items: center;
            color: white;
        }

        .container {
            text-align: center;
        }

        .logo {
            width: 180px;
            margin: 20px 0;
        }

        h1 {
            font-size: 22px;
            font-weight: 400;
            margin-bottom: 5px;
        }

        p {
            font-size: 14px;
            margin-bottom: 30px;
        }

        .btn {
            background-color: white;
            color: #4b36ff;
            border: none;
            padding: 12px 45px;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
        }

        .footer {
            margin-top: 50px;
        }

        .footer img {
            width: 140px;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>Bem-vindo ao</h1>

        <img src="/images/logo-loop.png" alt="Loop" class="logo" />

        <p>O novo sistema de pontos<br />para os estagiários da SECTI!</p>

        @* <a href="/Account/Login">
            <button class="btn">Entrar</button>
        </a> *@

        <div class="footer">
            <img src="/images/logo-governo.png" alt="Governo" />
        </div>
    </div>

</body>
</html>